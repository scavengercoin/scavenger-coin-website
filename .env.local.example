# Solana
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SCAV_MINT_ADDRESS=BGuhyvwuV1z6hGCPHVShrDBwHDypQvnQPvsR1RDHrA3j

# Hunt-pool wallet that pays out claims. Paste the JSON array secret key
# from solana-token/wallets/hunt-pool-keypair.json — server-side only,
# never expose this as a NEXT_PUBLIC_ var. Set as a real secret in Vercel,
# not committed here.
HUNT_POOL_SECRET_KEY=[1,2,3,...]

# Supabase (server-side; service role key bypasses RLS, keep it secret)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend (claim notification emails)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Scavenger Coin <onboarding@resend.dev>

# Admin panel (/admin) — required. Basic Auth password checked in proxy.ts.
# Without this set, /admin returns 503 rather than being left open.
ADMIN_PASSWORD=

# Upstash Redis (claim API rate limiting — 5 req/min/IP). Free tier at
# upstash.com. Without these set, rate limiting fails open (disabled, not
# broken) rather than taking the API down.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
